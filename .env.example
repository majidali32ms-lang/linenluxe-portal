# LinenLuxe Portal — environment variables
# Copy this file to a new file named ".env" (same folder) and paste YOUR values.
# Find these in Supabase: Project Settings -> API.
#   - Project URL            -> VITE_SUPABASE_URL
#   - Publishable key (sb_publishable_...) -> VITE_SUPABASE_PUBLISHABLE_KEY
# Both are safe for the browser (protected by the Row Level Security from Phase 1).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
